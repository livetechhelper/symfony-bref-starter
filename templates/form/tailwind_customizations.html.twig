{% extends 'tailwind_2_layout.html.twig' %}

{# Override form elements to match the login form styling exactly #}

{# Labels - using font-medium to match login form #}
{% block form_label -%}
    {% if label is not same as(false) -%}
        {% if compound is defined and compound -%}
            {%- set element = 'legend' -%}
            {%- set label_attr = label_attr|merge({class: 'block text-sm font-semibold leading-6 text-gray-900 dark:text-gray-200'}) -%}
        {% else -%}
            {%- set label_attr = label_attr|merge({class: 'block text-sm font-semibold leading-6 text-gray-900 dark:text-gray-200'}) -%}
        {%- endif %}
        {% if required -%}
            {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' required')|trim}) %}
        {%- endif %}
        <{{ element|default('label') }}{% if label_attr %}{% with { attr: label_attr } %}{{ block('attributes') }}{% endwith %}{% endif %}>
            {%- if translation_domain is same as(false) -%}
                {{- label -}}
            {%- else -%}
                {{- label|trans(label_translation_parameters, translation_domain) -}}
            {%- endif -%}
        </{{ element|default('label') }}>
    {%- endif -%}
{%- endblock form_label %}

{# Inputs - exact match to login form #}
{% block form_widget_simple -%}
    {% set attr = attr|merge({class: 'block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-primary-600 sm:text-sm sm:leading-6 dark:text-gray-100 dark:bg-gray-800 dark:ring-gray-700'}) %}
    {{- parent() -}}
{%- endblock form_widget_simple %}

{# Textarea - matching input styling #}
{% block textarea_widget -%}
    {% set attr = attr|merge({class: 'block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-primary-600 sm:text-sm sm:leading-6 dark:text-gray-100 dark:bg-gray-800 dark:ring-gray-700'}) %}
    {{- parent() -}}
{%- endblock textarea_widget %}

{# Checkboxes - exact match to login form #}
{% block checkbox_widget -%}
    {% set attr = attr|merge({class: 'h-4 w-4 rounded border-gray-300 text-primary-600 focus:ring-primary-600 dark:border-gray-700 dark:bg-gray-800'}) %}
    {{- parent() -}}
{%- endblock checkbox_widget %}

{# Checkbox labels - exact match to login form #}
{% block checkbox_label -%}
    {%- set label_attr = label_attr|merge({class: 'ml-2 block text-sm text-gray-900 dark:text-gray-200'}) -%}
    {%- if required -%}
        {%- set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' required')|trim}) -%}
    {%- endif -%}
    {%- if label is empty -%}
        {%- if label_format is not empty -%}
            {%- set label = label_format|replace({
                '%name%': name,
                '%id%': id,
            }) -%}
        {%- else -%}
            {%- set label = name|humanize -%}
        {%- endif -%}
    {%- endif -%}
    <label{% for attrname, attrvalue in label_attr %} {{ attrname }}="{{ attrvalue }}"{% endfor %}>
        {{ translation_domain is same as(false) ? label : label|trans(label_translation_parameters, translation_domain) }}
    </label>
{%- endblock checkbox_label %}

{# Select dropdowns - matching input styling #}
{% block choice_widget_collapsed -%}
    {% set attr = attr|merge({class: 'block w-full rounded-md border-0 px-3 py-1.5 text-gray-900 shadow-sm ring-1 ring-inset ring-gray-300 placeholder:text-gray-400 focus:ring-2 focus:ring-inset focus:ring-primary-600 sm:text-sm sm:leading-6 dark:text-gray-100 dark:bg-gray-800 dark:ring-gray-700'}) %}
    {{- parent() -}}
{%- endblock choice_widget_collapsed %}

{# Buttons - exact match to login form #}
{% block button_widget -%}
    {% set attr = attr|merge({class: 'flex w-full justify-center rounded-md bg-primary-600 px-3 py-2 text-sm font-semibold leading-6 text-white shadow-sm hover:bg-primary-500 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary-600 transition-colors duration-200'}) %}
    {{- parent() -}}
{%- endblock button_widget %}

{# Form row - matching login form spacing #}
{% block form_row -%}
    {%- set row_attr = row_attr|merge({class: 'mb-4'}) -%}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        {{- form_label(form) -}}
        <div class="mt-2">
            {{- form_widget(form) -}}
        </div>
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock form_row %}

{# Checkbox row - matching login form layout #}
{% block checkbox_row -%}
    {%- set row_attr = row_attr|merge({class: 'mb-4'}) -%}
    <div{% with {attr: row_attr} %}{{ block('attributes') }}{% endwith %}>
        <div class="flex items-center">
            {{- form_widget(form) -}}
            {{- form_label(form) -}}
        </div>
        {{- form_errors(form) -}}
        {{- form_help(form) -}}
    </div>
{%- endblock checkbox_row %}

{# Error messages - with red styling #}
{% block form_errors -%}
    {%- if errors|length > 0 -%}
        <ul class="mt-1 text-sm text-red-600 dark:text-red-400">
            {%- for error in errors -%}
                <li>{{ error.message }}</li>
            {%- endfor -%}
        </ul>
    {%- endif -%}
{%- endblock form_errors %}

{# Help text - with proper styling #}
{% block form_help -%}
    {%- if help is not empty -%}
        <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{{ help }}</p>
    {%- endif -%}
{%- endblock form_help %} 