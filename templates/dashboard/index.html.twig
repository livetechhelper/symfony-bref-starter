{% extends 'base.html.twig' %}

{% block title %}Dashboard{% endblock %}

{% block body %}
<div class="max-w-4xl mx-auto py-8">
    <div class="bg-white dark:bg-gray-800 shadow rounded-lg overflow-hidden">
        <div class="px-6 py-6 border-b border-gray-200 dark:border-gray-700 flex flex-col sm:flex-row sm:items-center">
            <div class="flex-shrink-0 mb-4 sm:mb-0 sm:mr-6">
                <div class="h-16 w-16 rounded-full bg-primary-100 dark:bg-primary-900 flex items-center justify-center text-primary-700 dark:text-primary-300 text-xl font-bold">
                    {{ user.firstName|slice(0, 1)|upper }}{{ user.lastName|slice(0, 1)|upper }}
                </div>
            </div>
            <div>
                <h1 class="text-xl font-bold text-gray-900 dark:text-white">
                    Welcome, {{ user.firstName }}!
                </h1>
                <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">
                    Here's an overview of your account
                </p>
            </div>
        </div>
        
        <div class="px-6 py-6">
            <div class="grid grid-cols-1 gap-6">
                <!-- Account Information -->
                <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-6">
                    <div class="flex justify-between items-center mb-6">
                        <h2 class="text-base font-medium text-gray-900 dark:text-white">Account Information</h2>
                        <a href="#" class="text-sm text-primary-600 hover:text-primary-500 dark:text-primary-400 dark:hover:text-primary-300">
                            Edit Profile
                        </a>
                    </div>
                    
                    <div class="space-y-5">
                        <div class="flex flex-col sm:flex-row border-b border-gray-200 dark:border-gray-600 pb-4">
                            <div class="w-full sm:w-1/3 mb-1 sm:mb-0">
                                <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Full Name</span>
                            </div>
                            <div class="w-full sm:w-2/3">
                                <span class="text-sm text-gray-900 dark:text-white">{{ user.firstName }} {{ user.lastName }}</span>
                            </div>
                        </div>
                        
                        <div class="flex flex-col sm:flex-row border-b border-gray-200 dark:border-gray-600 pb-4">
                            <div class="w-full sm:w-1/3 mb-1 sm:mb-0">
                                <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Email Address</span>
                            </div>
                            <div class="w-full sm:w-2/3">
                                <span class="text-sm text-gray-900 dark:text-white">{{ user.email }}</span>
                            </div>
                        </div>
                        
                        <div class="flex flex-col sm:flex-row border-b border-gray-200 dark:border-gray-600 pb-4">
                            <div class="w-full sm:w-1/3 mb-1 sm:mb-0">
                                <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Account Created</span>
                            </div>
                            <div class="w-full sm:w-2/3">
                                <span class="text-sm text-gray-900 dark:text-white">{{ user.createdAt ? user.createdAt|date('F j, Y') : 'N/A' }}</span>
                            </div>
                        </div>
                        
                        <div class="flex flex-col sm:flex-row">
                            <div class="w-full sm:w-1/3 mb-1 sm:mb-0">
                                <span class="text-sm font-medium text-gray-500 dark:text-gray-400">Roles</span>
                            </div>
                            <div class="w-full sm:w-2/3">
                                <div class="flex flex-wrap gap-2">
                                    {% for role in user.roles %}
                                        {% if role != 'ROLE_USER' %}
                                            <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-primary-100 text-primary-800 dark:bg-primary-800 dark:text-primary-100">
                                                {{ role|replace({'ROLE_': ''}) }}
                                            </span>
                                        {% endif %}
                                    {% endfor %}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                
                <!-- System Information -->
                <div class="bg-gray-50 dark:bg-gray-700 rounded-lg p-6">
                    <h2 class="text-base font-medium text-gray-900 dark:text-white mb-6">System Information</h2>
                    
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm">
                            <div class="flex items-center">
                                <div class="flex-shrink-0 h-10 w-10 rounded-md bg-primary-100 dark:bg-primary-900 flex items-center justify-center">
                                    <svg class="h-6 w-6 text-primary-600 dark:text-primary-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 10h16M4 14h16M4 18h16" />
                                    </svg>
                                </div>
                                <div class="ml-4">
                                    <h3 class="text-sm font-medium text-gray-900 dark:text-white">Symfony Version</h3>
                                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">7.2</p>
                                </div>
                            </div>
                            <div class="mt-4 text-xs text-gray-500 dark:text-gray-400">
                                <a href="https://symfony.com/doc/7.2/index.html" target="_blank" rel="noopener noreferrer" class="inline-flex items-center hover:text-primary-600 dark:hover:text-primary-400">
                                    View Documentation
                                    <svg class="ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
                                        <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                        
                        <div class="bg-white dark:bg-gray-800 rounded-lg p-4 shadow-sm">
                            <div class="flex items-center">
                                <div class="flex-shrink-0 h-10 w-10 rounded-md bg-primary-100 dark:bg-primary-900 flex items-center justify-center">
                                    <svg class="h-6 w-6 text-primary-600 dark:text-primary-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                    </svg>
                                </div>
                                <div class="ml-4">
                                    <h3 class="text-sm font-medium text-gray-900 dark:text-white">PHP Version</h3>
                                    <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">8.2</p>
                                </div>
                            </div>
                            <div class="mt-4 text-xs text-gray-500 dark:text-gray-400">
                                <a href="https://www.php.net/manual/en/migration82.php" target="_blank" rel="noopener noreferrer" class="inline-flex items-center hover:text-primary-600 dark:hover:text-primary-400">
                                    View Documentation
                                    <svg class="ml-1 h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                                        <path d="M10 12a2 2 0 100-4 2 2 0 000 4z" />
                                        <path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd" />
                                    </svg>
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %} 